# Copy to .env for docker compose. Never commit .env.
POSTGRES_PASSWORD=restaurantos
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=
# Optional demo mode: the API refuses to run simulators in Production, so also set API_ENVIRONMENT=Staging.
API_ENVIRONMENT=Production
MOCK_PAYMENT_WEBHOOK_SECRET=
ENABLE_MOCK_SIMULATORS=false
# Network of the nginx proxy container (X-Forwarded-For is trusted only from here).
TRUSTED_PROXY_NETWORK=172.16.0.0/12
